<?xml version="1.0" encoding="utf-8"?>
<!-- 首页：上下两半各占 (屏高-通知栏-tab栏)/2。外层垂直 LinearLayout（非 ScrollView），
     两卡片 height=0dp + weight=1 平分容器高度。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ================= 上半部：导航 HUD（仿高德悬浮窗） ================= -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.CarDash.Hud"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 第一行：大箭头 + 主指令 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hudArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑"
                    android:textColor="@color/accent_blue"
                    android:textSize="56sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hudInstruction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/hud_idle"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hudDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 第二行：车道指引（箭头串） -->
            <TextView
                android:id="@+id/hudLane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:letterSpacing="0.3"
                android:text=""
                android:textColor="@color/lane_arrow"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- 第三行：车速 + 红绿灯读秒 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hudSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hud_speed_unknown"
                    android:textColor="@color/speed_color"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hudRedLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/red_light"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ================= 下半部：播放器（参照 TikTok 迷你卡片布局） ================= -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.CarDash.Hud"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <!-- 内部必须包一层垂直 LinearLayout，避免卡片(FrameLayout)直接叠放多个子 View 导致重叠 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 顶行：标题/歌手（左） + 封面（右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/playerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/player_default_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/playerArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/player_default_artist"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/playerAlbum"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_album_placeholder"
                        android:clipToOutline="true"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop" />

                    <ImageButton
                        android:id="@+id/btnScan"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/player_scan"
                        android:padding="10dp"
                        android:src="@drawable/ic_scan" />
                </LinearLayout>
            </LinearLayout>

            <!-- 中间描述行（占剩余空间，垂直居中） -->
            <TextView
                android:id="@+id/playerNow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <!-- 细进度条 -->
            <SeekBar
                android:id="@+id/playerProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progress="0"
                android:progressTint="@color/accent_blue"
                android:thumbTint="@color/accent_blue" />

            <!-- 控制行：上一首 / 播放暂停 / 下一首（居中，参照参考图间距） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_prev"
                    android:padding="12dp"
                    android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_play"
                    android:padding="14dp"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_next"
                    android:padding="12dp"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
